{
  "name": "pixel-studio-ipad",
  "version": "0.16.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.cjs",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precache": "node scripts/precache.js",
    "precache:check": "node scripts/precache.js --check",
    "check": "npm run lint && npm run format:check && npm test && npm run precache:check",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
